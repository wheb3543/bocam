# إعدادات اختيارية لتسريع بيئة التطوير

# تفعيل التحديث السريع لمكونات React أثناء التطوير.
VITE_FAST_REFRESH=true

# تحديد مستوى السجلات التي يكتبها الخادم.
LOG_LEVEL=error

# ============================================================================
# متغيرات غير مستخدمة حاليًا في الكود
# هذه القيم موثقة هنا فقط، ولا يتم تطبيقها تلقائيًا عند تشغيل المشروع.
# ============================================================================

# تعطيل فحص TypeScript أثناء التطوير؛ لا يقرأه إعداد Vite الحالي.
VITE_DISABLE_TS_CHECK=true

# تعطيل تحليلات الواجهة؛ لا يوجد كود حاليًا يقرأ هذا المتغير.
VITE_DISABLE_ANALYTICS=true

# تعطيل التتبع؛ لا يوجد كود حاليًا يقرأ هذا المتغير.
VITE_DISABLE_TRACKING=true

# حجم تجمع اتصالات قاعدة البيانات؛ لم يتم ربطه بإعداد الاتصال الحالي.
DB_POOL_SIZE=5

# مهلة اتصال قاعدة البيانات؛ لم يتم ربطها بإعداد الاتصال الحالي.
DB_CONNECTION_TIMEOUT=30000
