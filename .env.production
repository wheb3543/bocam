# إعدادات بيئة الإنتاج. تُحقن الأسرار الفعلية من منصة النشر.

# إعدادات قاعدة البيانات الرئيسية.
DATABASE_URL=mysql://user:@localhost:3306/bocam
DB_HOST=
DB_PORT=3306
DB_NAME=bocam
DB_USER=root
DB_PASSWORD=

# إعدادات قاعدة بيانات المستشفى الوسيطة.
HOSPITAL_DB_URL=
HOSPITAL_DB_HOST=
HOSPITAL_DB_PORT=3306
HOSPITAL_DB_NAME=hospital_db_prod
HOSPITAL_DB_USER=root
HOSPITAL_DB_PASSWORD=

# إعدادات رفع الملفات في الإنتاج.
FILE_UPLOAD_BASE_URL=https://sghcrm.production.local/lab-results
FILE_UPLOAD_PATH=/var/www/sghcrm/public/lab-results

# إعدادات نبضة الاتصال المركزية.
CENTRAL_ACTIVATION_URL=https://ideahub-op7dfwr6.manus.space/heartbeat

# إعدادات فحص التحديثات.
CENTRAL_UPDATE_URL=https://ideahub-op7dfwr6.manus.space/updates/check

# إصدار بروتوكول الاتصال المركزي.
PROTOCOL_VERSION=1.0.0

# إعدادات Meta Pixel وواجهة التحويل.
VITE_META_PIXEL_ID=2008380493273171
META_ACCESS_TOKEN=prod-meta-access-token
META_TEST_EVENT_CODE=PROD12345

# إعدادات WhatsApp Business.
WHATSAPP_ACCESS_TOKEN=prod-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=prod-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=prod-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=prod-webhook-verify-token

# إعدادات خدمة البريد الإلكتروني.
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=prod-sendgrid-api-key
EMAIL_FROM=noreply@sgh.ye
EMAIL_FROM_NAME=Saudi German Hospital

# إعدادات خدمة الرسائل النصية.
SMS_SERVICE=twilio
SMS_API_KEY=prod-twilio-api-key
SMS_API_SECRET=prod-twilio-api-secret
SMS_PHONE_NUMBER=+1234567890

# إعدادات OAuth والمصادقة.
JWT_SECRET=
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://portal.manus.im
VITE_APP_ID=
OWNER_OPEN_ID=
OWNER_NAME=Production Owner
VITE_OWNER_OPEN_ID=
VITE_OWNER_NAME=Production Owner

# إعدادات التطبيق العامة.
PORT=3000
NODE_ENV=production

# إعدادات المحاكاة، ويجب أن تبقى معطلة في الإنتاج.
MOCK_MODE=false
MOCK_WHATSAPP=false
MOCK_SMS=false
MOCK_EMAIL=false
MOCK_META_PIXEL=false
MOCK_LOGGING=false
MOCK_LOG_LEVEL=error

# إعدادات Redis في الإنتاج.
REDIS_URL=redis://redis.production.local:6379
REDIS_PASSWORD=

# إعدادات التحليلات.
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# إعدادات Forge API المدمجة.
BUILT_IN_FORGE_API_URL=https://forge.manus.ai
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.manus.ai
VITE_FRONTEND_FORGE_API_KEY=

# إعدادات Node.js والذاكرة.
NODE_OPTIONS=--max-old-space-size=4096

# لا توجد متغيرات غير مستخدمة مؤكدة في هذا القالب.
