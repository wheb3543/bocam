# إعدادات بيئة التطوير. كل متغير أدناه موثق ضمن مجموعة وظيفته.

# إعدادات قاعدة البيانات: الرابط والمضيف والمنفذ والاعتماد.
DATABASE_URL=mysql://root:@127.0.0.1:3306/bocam
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bocam
DB_USER=root
DB_PASSWORD=

# إعدادات قاعدة بيانات المستشفى الوسيطة.
HOSPITAL_DB_URL=mysql://root:@127.0.0.1:3306/hospital_db_dev
HOSPITAL_DB_HOST=127.0.0.1
HOSPITAL_DB_PORT=3306
HOSPITAL_DB_NAME=hospital_db_dev
HOSPITAL_DB_USER=root
HOSPITAL_DB_PASSWORD=

# إعدادات رفع الملفات.
FILE_UPLOAD_BASE_URL=http://localhost:5173/lab-results
FILE_UPLOAD_PATH=./public/lab-results

# إعدادات نبضة الاتصال المركزية.
CENTRAL_ACTIVATION_URL=

# إعدادات فحص التحديثات.
CENTRAL_UPDATE_URL=

# إصدار بروتوكول الاتصال المركزي.
PROTOCOL_VERSION=1.0.0

# إعدادات Meta Pixel وواجهة التحويل.
VITE_META_PIXEL_ID=2008380493273171
META_ACCESS_TOKEN=dev-meta-access-token
META_TEST_EVENT_CODE=TEST12345

# إعدادات WhatsApp Business.
WHATSAPP_ACCESS_TOKEN=dev-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=dev-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=dev-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-webhook-verify-token

# إعدادات خدمة البريد الإلكتروني.
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=dev-sendgrid-api-key
EMAIL_FROM=noreply@sgh.ye
EMAIL_FROM_NAME=Saudi German Hospital

# إعدادات خدمة الرسائل النصية.
SMS_SERVICE=twilio
SMS_API_KEY=dev-twilio-api-key
SMS_API_SECRET=dev-twilio-api-secret
SMS_PHONE_NUMBER=+1234567890

# إعدادات OAuth والمصادقة.
JWT_SECRET=SGH_CRM_SECURE_JWT_SECRET_KEY_FOR_DEVELOPMENT_2026_VERY_LONG_AND_SECURE_STRING_FOR_AUTHENTICATION_PURPOSES_EXTENDED_FOR_MAXIMUM_SECURITY
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://portal.manus.im
VITE_APP_ID=dev-app-id
OWNER_OPEN_ID=dev-owner-openid
OWNER_NAME=Development Owner
VITE_OWNER_OPEN_ID=dev-owner-openid
VITE_OWNER_NAME=Development Owner

# إعدادات التطبيق العامة.
PORT=3000
NODE_ENV=development

# إعدادات المحاكاة أثناء التطوير.
MOCK_MODE=true
MOCK_WHATSAPP=true
MOCK_SMS=true
MOCK_EMAIL=true
MOCK_META_PIXEL=true
MOCK_LOGGING=true
MOCK_LOG_LEVEL=debug

# إعدادات Redis الاختيارية.
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# إعدادات التحليلات الاختيارية.
GOOGLE_ANALYTICS_ID=

# إعدادات Forge API المدمجة.
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=dev-forge-api-key
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_KEY=dev-forge-api-key

# إعدادات Node.js والذاكرة.
NODE_OPTIONS=--max-old-space-size=4096

# لا توجد متغيرات غير مستخدمة مؤكدة في هذا القالب.