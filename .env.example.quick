# ==============================================================================
# قالب تشغيل سريع لبيئة BOCAM CRM المحلية.
# ==============================================================================
# يشغل المشروع بأقل إعدادات ممكنة مع تفعيل المحاكاة.
# ==============================================================================

# اسم البيئة ومنفذ التطبيق.
NODE_ENV=development
PORT=3000

# بيانات اتصال MySQL المحلية.
DATABASE_URL=mysql://sgh_user:userpassword@localhost:3306/sgh_crm
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sgh_crm
DB_USER=sgh_user
DB_PASSWORD=userpassword

# متغيرات إنشاء حاوية MySQL في Docker Compose.
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=sgh_crm
MYSQL_USER=sgh_user
MYSQL_PASSWORD=userpassword

# مفاتيح المصادقة وأمان الجلسات.
JWT_SECRET=bocam_crm_quick_start_super_secret_key_32_chars_min
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://portal.manus.im
VITE_APP_ID=mock-app-id
VITE_OWNER_OPEN_ID=mock-owner-id
VITE_OWNER_NAME="المطور المحلي"

# مفاتيح المحاكاة التي تمنع الحاجة إلى الخدمات الخارجية.
MOCK_MODE=true
MOCK_WHATSAPP=true
MOCK_SMS=true
MOCK_EMAIL=true
MOCK_META_PIXEL=true
MOCK_LOGGING=true
MOCK_LOG_LEVEL=debug

# إعدادات Redis الاختيارية.
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=defaultpassword

# بيانات المستشفى والهوية وروابط التواصل موجودة في tenants/tenant-sgh/branding/config.ts.
