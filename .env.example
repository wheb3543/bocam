# قالب إعدادات قاعدة البيانات الرئيسية.
DATABASE_URL=mysql://user:password@localhost:3306/sgh_crm
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sgh_crm
DB_USER=root
DB_PASSWORD=password

# إعدادات قاعدة بيانات المستشفى الوسيطة.
HOSPITAL_DB_URL=mysql://user:password@localhost:3306/hospital_db
HOSPITAL_DB_HOST=localhost
HOSPITAL_DB_PORT=3306
HOSPITAL_DB_NAME=hospital_db
HOSPITAL_DB_USER=root
HOSPITAL_DB_PASSWORD=password

# إعدادات رفع الملفات.
FILE_UPLOAD_BASE_URL=http://localhost:5173/lab-results
FILE_UPLOAD_PATH=./public/lab-results

# إعدادات الترخيص الداخلية، وتُدار تلقائيًا.
# License validation is automatic based on hardware ID and cryptographic verification
# Do not manually set these values
# LICENSE_KEY: (auto-generated)
# HARDWARE_ID: (auto-detected)

# إعدادات نبضة الاتصال المركزية.
# Central server URL for silent heartbeat reporting
# Change this to your actual central server URL
CENTRAL_ACTIVATION_URL=https://ideahub-op7dfwr6.manus.space/heartbeat

# إعدادات فحص التحديثات.
# Central server URL for update checks
CENTRAL_UPDATE_URL=https://ideahub-op7dfwr6.manus.space/updates/check

# إصدار بروتوكول الاتصال المركزي.
PROTOCOL_VERSION=1.0.0

# إعدادات Meta Pixel وواجهة التحويل.
VITE_META_PIXEL_ID=2008380493273171
META_ACCESS_TOKEN=your-meta-access-token
META_TEST_EVENT_CODE=TEST12345

# إعدادات WhatsApp Business.
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# إعدادات البريد الإلكتروني.
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@sgh.ye
EMAIL_FROM_NAME=Saudi German Hospital

# إعدادات الرسائل النصية.
SMS_SERVICE=twilio
SMS_API_KEY=your-twilio-api-key
SMS_API_SECRET=your-twilio-api-secret
SMS_PHONE_NUMBER=+1234567890

# إعدادات OAuth والمصادقة.
JWT_SECRET=your-jwt-secret-min-32-chars-for-security
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://portal.manus.im
VITE_APP_ID=your-app-id
VITE_OWNER_OPEN_ID=your-owner-openid
VITE_OWNER_NAME=Your Name

# إعدادات التطبيق العامة.
# App title is auto-generated from COMPANY_ARABIC_NAME/COMPANY_ENGLISH_NAME
# Use getAppTitle() function in code instead of hardcoding
PORT=3000
NODE_ENV=development

# إعدادات المحاكاة للتطوير فقط.
MOCK_MODE=true
MOCK_WHATSAPP=true
MOCK_SMS=true
MOCK_EMAIL=true
MOCK_META_PIXEL=true
MOCK_LOGGING=true
MOCK_LOG_LEVEL=debug

# إعدادات Redis الاختيارية للتخزين المؤقت.
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# إعدادات التحليلات الاختيارية.
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# إعدادات Node.js والذاكرة.
NODE_OPTIONS=--max-old-space-size=4096

# لا توجد متغيرات غير مستخدمة مؤكدة؛ هذا الملف قالب للنسخ إلى .env.
