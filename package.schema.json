{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Package.json Schema",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "type": { "type": "string" },
    "license": { "type": "string" },
    "scripts": { "type": "object" },
    "dependencies": { "type": "object" },
    "devDependencies": { "type": "object" },
    "peerDependencies": { "type": "object" },
    "optionalDependencies": { "type": "object" },
    "engines": { "type": "object" },
    "os": { "type": "array", "items": { "type": "string" } },
    "cpu": { "type": "array", "items": { "type": "string" } },
    "private": { "type": "boolean" },
    "workspaces": { "type": "array" },
    "repository": { "type": "object" },
    "author": { "type": ["string", "object"] },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "bugs": { "type": "object" },
    "homepage": { "type": "string" },
    "main": { "type": "string" },
    "module": { "type": "string" },
    "bin": { "type": ["string", "object"] },
    "files": { "type": "array", "items": { "type": "string" } },
    "man": { "type": "array", "items": { "type": "string" } },
    "directories": { "type": "object" },
    "config": { "type": "object" }
  },
  "required": ["name", "version"]
}
